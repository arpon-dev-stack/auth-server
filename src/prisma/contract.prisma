// use prisma-8

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  username   String?
  name       String?
  password   String
  isVerified Boolean
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  @@map("user")
}

model UserOtp {
  id        Int      @id @default(autoincrement())
  otp       String
  otpExpiry DateTime
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@map("user_otp")
}
