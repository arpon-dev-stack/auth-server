# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/your_database_name?schema=public

# JWT Authentication (Secrets must be at least 32 characters long)
JWT_SECRET=your_at_least_32_character_long_super_secret_jwt_key_12345
JWT_REFRESH_SECRET=your_at_least_32_character_long_super_secret_refresh_key_12345

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM=noreply@yourdomain.com